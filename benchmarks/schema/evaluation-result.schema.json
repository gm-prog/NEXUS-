{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "$id": "https://nexus.local/schemas/evaluation-result.schema.json",
  "title": "NEXUS Evaluation Result",
  "description": "Contract for a completed evaluation run against a benchmark scenario.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "run_id",
    "run_timestamp",
    "agent_version",
    "model_id",
    "prompt_version",
    "tool_set_version",
    "detection_result",
    "service_localization_result",
    "root_cause_result",
    "change_attribution_result",
    "evidence_references_used",
    "invalid_evidence_references",
    "missing_evidence_references",
    "supporting_evidence_coverage",
    "contradicting_evidence_coverage",
    "uncertainty_behavior",
    "tool_call_count",
    "repeated_tool_call_count",
    "latency_ms",
    "cost_usd",
    "remediation_outcome",
    "evaluator_version",
    "scores",
    "failure_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^INC-\\d{3}$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "agent_version": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "tool_set_version": {
      "type": "string"
    },
    "detection_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detected", "detection_latency_ms", "false_positive"],
      "properties": {
        "detected": { "type": "boolean" },
        "detection_latency_ms": { "type": "integer", "minimum": 0 },
        "false_positive": { "type": "boolean" },
        "detection_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "service_localization_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identified_service_id", "correct", "confidence"],
      "properties": {
        "identified_service_id": { "type": "string", "format": "uuid" },
        "correct": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "alternative_services_considered": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      }
    },
    "root_cause_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identified_root_cause_type", "correct", "confidence", "causal_chain_correct"],
      "properties": {
        "identified_root_cause_type": { "type": "string" },
        "correct": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "causal_chain_correct": { "type": "boolean" },
        "causal_chain_details": { "type": "string" }
      }
    },
    "change_attribution_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributed_change_id", "correct", "confidence"],
      "properties": {
        "attributed_change_id": { "type": "string" },
        "correct": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "evidence_references_used": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ev-[a-z0-9-]+$" },
      "description": "Evidence IDs referenced by the agent in its diagnosis"
    },
    "invalid_evidence_references": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Evidence IDs referenced by agent that do not exist in the evidence catalog"
    },
    "missing_evidence_references": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ev-[a-z0-9-]+$" },
      "description": "Required evidence IDs (from expected_diagnosis.must_include_evidence_ids) not referenced"
    },
    "supporting_evidence_coverage": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Fraction of ground truth supporting evidence referenced"
    },
    "contradicting_evidence_coverage": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Fraction of ground truth contradicting evidence acknowledged"
    },
    "uncertainty_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abstained", "uncertainty_rationale_provided", "appropriate"],
      "properties": {
        "abstained": { "type": "boolean", "description": "Whether agent explicitly abstained or expressed uncertainty" },
        "uncertainty_rationale_provided": { "type": "boolean" },
        "appropriate": { "type": "boolean", "description": "Whether uncertainty was appropriate per ground truth" }
      }
    },
    "tool_call_count": {
      "type": "integer",
      "minimum": 0
    },
    "repeated_tool_call_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of tool calls with identical parameters (inefficiency indicator)"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "cost_usd": {
      "type": ["number", "null"],
      "minimum": 0.0
    },
    "remediation_outcome": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "proposed": { "type": "boolean" },
        "sandbox_passed": { "type": "boolean" },
        "tests_passed": { "type": "boolean" },
        "scans_passed": { "type": "boolean" },
        "human_approved": { "type": "boolean" },
        "pr_created": { "type": "boolean" }
      },
      "description": "Only populated when remediation is evaluated (Phase 7+)"
    },
    "evaluator_version": {
      "type": "string"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection",
        "service_localization",
        "root_cause_accuracy",
        "change_attribution",
        "evidence_grounding",
        "evidence_reference_validity",
        "required_evidence_coverage",
        "supporting_evidence_coverage",
        "contradicting_evidence_coverage",
        "causal_chain_correctness",
        "false_attribution_rate",
        "abstention_quality",
        "investigation_coverage",
        "tool_efficiency"
      ],
      "properties": {
        "detection": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "service_localization": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "root_cause_accuracy": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "change_attribution": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "evidence_grounding": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "evidence_reference_validity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "required_evidence_coverage": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "supporting_evidence_coverage": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "contradicting_evidence_coverage": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "causal_chain_correctness": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "false_attribution_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "abstention_quality": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "investigation_coverage": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "tool_efficiency": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "failure_notes": {
      "type": ["string", "null"],
      "description": "Notes on any failures or anomalies during evaluation"
    }
  }
}